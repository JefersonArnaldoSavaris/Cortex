# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Free market data (REST + WebSocket). Create a key at https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Product API database (SQLite for local development; PostgreSQL in production)
DATABASE_URL=sqlite:///./cortex_app.db

# Supabase/PostgreSQL runtime (prefer Direct or Session pooler on port 5432).
# CORTEX_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Used by the one-time SQLite migration script before switching the runtime URL.
# CORTEX_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

CORTEX_DB_POOL_SIZE=5
CORTEX_DB_MAX_OVERFLOW=5
CORTEX_DB_POOL_RECYCLE_SECONDS=300

# Authentication and browser access. Use secure=true and samesite=none
# when the frontend and API are hosted on different HTTPS domains.
CORTEX_AUTH_SECRET=
CORTEX_AUTH_COOKIE_SECURE=false
CORTEX_AUTH_COOKIE_SAMESITE=lax
CORTEX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORTEX_BROKER_CREDENTIALS_KEY=

# Use only when the API cannot access the Windows MT5 terminal directly.
CORTEX_MT5_BRIDGE_URL=

# Keep false until real-order controls are reviewed and intentionally enabled.
CORTEX_LIVE_TRADING_ENABLED=false
